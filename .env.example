# Copia este archivo a .env.local y pon tus valores. .env.local NO se sube a git.
# En producción estas mismas variables se cargan en Vercel (Settings → Environment Variables).

# Mapbox: token público (empieza con pk.) restringido al dominio somosnosotros.org en tu cuenta de Mapbox.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Opcional: tu estilo claro (mapbox://styles/TU_USUARIO/ID_DEL_ESTILO). Vacío = estilo claro estándar de Mapbox.
NEXT_PUBLIC_MAPBOX_STYLE=

# Supabase: URL del proyecto y llave pública (la "publishable" o la "anon"). Ambas están en Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para aplicar migraciones desde tu computadora (npm run db:push). Supabase → Connect → Direct connection.
SUPABASE_DB_URL=

# Solo en el servidor (Vercel, variable sensible): activa "llenar el evento desde el cartel".
ANTHROPIC_API_KEY=

# Avisos por correo (solo servidor, Vercel sensible). Sin llave, no se manda nada.
RESEND_API_KEY=
CORREO_REMITENTE=somosnosotros <avisos@somosnosotros.org>
# Lo pone Vercel para llamar /api/recordatorios cada mañana.
CRON_SECRET=
